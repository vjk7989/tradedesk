# Public base domain; Caddy serves mcp.$DOMAIN and openalgo.$DOMAIN (DNS A records must point at the VPS).
DOMAIN=example.com
# Email for Let's Encrypt registration.
ACME_EMAIL=you@example.com

# Bearer token clients present to trade-mcp. Generate: openssl rand -hex 32
MCP_TOKEN=replace-with-openssl-rand-hex-32
# Optional read-only bearer token for scheduled jobs (>=24 chars, different from MCP_TOKEN). Generate: openssl rand -hex 32
MCP_TOKEN_READONLY=
# Execute time limit in ms, clamped 5000-900000. Set >=660000 if you use backtest.walkForward. MCP clients also have their own tool-call timeout.
EXECUTE_TIMEOUT_MS=60000
# Max concurrent execute runs, 1..32, default 4. Each run uses ≈ sandbox memory (64 MB default) + 32 MB WASM headroom (ADR-19), so size it to the VPS RAM. Extra calls get "busy" immediately.
EXECUTE_MAX_CONCURRENT=4
# Container memory limits for trade-mcp, bt-service and Caddy (the last line of defence): a service over its limit is
# OOM-killed and restarted by `restart: unless-stopped` while the others keep running. memswap_limit equals mem_limit,
# so swap cannot delay the kill. Defaults total 1024 + 1024 + 128 = 2176 MB (~2.1 GB), leaving the rest of a 4 GB VPS
# for OpenAlgo and the OS.
# trade-mcp worst case = base + EXECUTE_MAX_CONCURRENT x (memoryBytes + 32 MB WASM, ADR-19 + memoryBytes pending binding
# argument bytes, ADR-18). Measured base RSS ~100 MB, memoryBytes default 64 MB: 100 + 4 x (64 + 32 + 64) = 740 MB.
# The 1g default adds headroom for the V8 heap. If you raise EXECUTE_MAX_CONCURRENT, add ~160 MB per extra run.
TRADE_MCP_MEM_LIMIT=1g
# bt-service: pandas backtests and walk-forward (measured peak ~282 MB). BT_CPUS caps its CPUs.
BT_MEM_LIMIT=1g
BT_CPUS=1
CADDY_MEM_LIMIT=128m
# OpenAlgo holds the broker session and has NO memory limit by default (an OOM kill there is what we avoid). To opt in,
# create deploy/docker-compose.override.yml with `services: {openalgo: {mem_limit: 1536m, memswap_limit: 1536m}}`.
# Its 512 MB shm_size counts against any limit you set, so leave well above 512 MB.
# Shared token between trade-mcp and bt-service. Generate: openssl rand -hex 32
BT_TOKEN=replace-with-openssl-rand-hex-32

# OpenAlgo API key (create in the OpenAlgo UI after first login).
OPENALGO_API_KEY=replace-with-openalgo-api-key
# Path to OpenAlgo's own .env file (copy vendor/openalgo/.sample.env and edit; set
# HOST_SERVER=https://openalgo.$DOMAIN, FLASK_HOST_IP=0.0.0.0, WEBSOCKET_HOST=0.0.0.0,
# WEBSOCKET_URL=wss://openalgo.$DOMAIN/ws (verify after first login), and fresh APP_KEY / API_KEY_PEPPER).
OPENALGO_ENV_FILE=./openalgo.env
# Directory holding the OpenAlgo checkout used to build the image (contains Dockerfile).
OPENALGO_SRC=../vendor/openalgo

# paper = no real orders; live = real orders.
MODE=paper
# Host path of the risk config (copy risk.example.json to risk.json and edit).
RISK_CONFIG_FILE=./risk.example.json

# OAuth for ChatGPT / claude.ai connectors (off by default). To enable: OAUTH_ENABLED=1,
# OAUTH_ISSUER_URL=https://mcp.$DOMAIN, and a password hash made with:
#   node -e "const c=require('crypto');const s=c.randomBytes(16);console.log('scrypt:'+s.toString('hex')+':'+c.scryptSync(process.argv[1],s,64).toString('hex'))" 'your-password'
OAUTH_ENABLED=0
OAUTH_ISSUER_URL=https://mcp.example.com
OAUTH_PASSWORD_HASH=replace-with-scrypt-hash
# Comma list of hosts allowed as OAuth redirect targets.
OAUTH_ALLOWED_REDIRECT_HOSTS=chatgpt.com,claude.ai,claude.com

# paper-bot (dashboard at https://dash.$DOMAIN, behind Caddy basic auth; the app itself has no auth).
DASH_USER=admin
# bcrypt hash, generate: docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-password'
# Single-quote it in any shell; in this file the hash contains $ so keep it exactly as printed.
DASH_PASSWORD_HASH=replace-with-caddy-hash-password-output
PAPER_BOT_MEM_LIMIT=256m
SYMBOLS=BTCUSD
RESOLUTION=5m
INTERVAL_SEC=60
# Moving-average crossover windows.
FAST=9
SLOW=21
ALLOW_SHORT=0
NOTIONAL_USD=1000
START_CAPITAL_USD=10000
TAKER_FEE=0.0005
SLIPPAGE=0.0002
DELTA_BASE_URL=https://api.india.delta.exchange
